//problem-3
//pillar of oops
//encapsulation--- it means binding a data into a single unit(functions,data,variable)
//into a single unit called class and making some restrictions on this class members
//importance---> data security 
//               controlled access over my data 
//               validation before accessing the data
//               code  maintability
//getter is used to get the value and setter is used to set the value
#include<iostream>
using namespace std;

class bankAccount{
    private:
    int balance;
 public:   
void setbalance(int amount){
   if(amount>=0){
       balance=amount;
   }else{
       cout<<"enter a valid number...";
   }
}
public:
int getbalance(){
    return balance;
 }
};
int main(){
    bankAccount obj1;
    obj1.setbalance(6000);
    cout<<obj1.getbalance();
}
