//problem--3
//call by value//call by refrence
//call by value - photocopy,, passes values
//call by reference - original copy ,, passes address
#include<iostream>
using namespace std;

void updatebyValue(int a){
    a=500;
}
void updatebyRefrence(int &a){
    a=500;
}
int main(){
    int original=100;
    cout<<original<<"\n";
    updatebyValue(original);
    cout<<original<<"\n";
    updatebyRefrence(original);
    cout<<original;
}

