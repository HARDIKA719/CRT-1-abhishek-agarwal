#include<iostream>
using namespace std;

bool ispalindrome(string str){
    int start=0;
    int end=str.size()-1;
    
    while(start<end){
        if(str[start]!=str[end]){
            return false;
        }
        start++;
        end--;
    }
    return true;
}

int main()
{
    string str;
    cout<<"enter a string...";
    cin>>str;
    
    if(ispalindrome(str)){
        cout<<"palindrome string";
    }
    else{
        cout<<" given string i.e "<<str<< " is not a palindrome";
    }
}


