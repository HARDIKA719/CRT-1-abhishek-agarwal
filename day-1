//Temperature conversion(1)
//take input in the form of celcius and convert it into fahrenheit

#include<iostream>
using namespace std;
int main(){
    double celcius,fahrenheit;
    cin>>celcius;
    fahrenheit=(celcius*9.0/5.0)+32.0;
    cout<<fahrenheit<<endl;
    return 0;
}

