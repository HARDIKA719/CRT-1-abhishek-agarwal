//logical and relational operator
#include<iostream>
using namespace std;
int main(){
    int side1,side2,side3;
    cin>>side1>>side2>>side3;
    bool isequi=(side1>0)&&(side1==side2)&&(side2==side3);
    cout<<isequi<<endl;
    return 0;
}

//swap value of 2 variablea using 3rd variable
#include<iostream>
using namespace std;
int main(){
    int a;
    int b;
    cin>>a>>b;
    //swaping logic-create a temporary variable 
    int temp=a;
    a=b;
    b=temp;
    cout<<a<<"\n"<<b<<endl;
    return 0;
    
}

//area of shapes
//1-->circle
//2-->rectangle
//3-->triangle
#include<iostream>
using namespace std;
int main(){
    int choice;
    cin>>choice;
    if(choice==1){
        double radius;
        cin>>radius;
        cout<<3.14*radius*radius<<endl;
    }
    else if(choice==2){
        double length,width;
        cin>>length>>width;
        cout<<length*width<<endl;
    }
    else if(choice==3){
        double base,height;
        cin>>base>>height;
        cout<<0.5*base*height<<endl;
    }
    else{
        cout<<"invalid choice"<<endl;
    }
    return 0;
}
