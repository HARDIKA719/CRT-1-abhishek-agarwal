//if-condition(10)
//verify user's age is eligilble for vote or not
#include<iostream>
using namespace std;
int main(){
    int age;
    cin>>age;
    if(age>=18){
        cout<<"eligible for vote"<<endl;
        
    }
    return 0;
}

//if-else-condition(11)
//verify user's age is eligilble for vote or not
#include<iostream>
using namespace std;
int main(){
    int age;
    cin>>age;
    if(age>=18){
        cout<<"eligible for vote"<<endl;
        
    }
    else{
        cout<<"not eligible for vote"<<endl;
    }
    return 0;
}

//nested if else condition(12)
//verify user's age is eligilble for vote or not
#include<iostream>
using namespace std;
int main(){
    int age;
    cin>>age;
    
    if(age>=18){
        if(age>=100){
            cout<<"eligible for vote but we are super senior citizen";
        }
        else{
            cout<<"eligible for vote";
        }
    }
    else{
        if(age<0){
            cout<<"invalid age";
        }
        else{
            cout<<"not eligible for vote";
        }
    }
    return 0;
}

//continue statement(13)
//print 1 to N and avoid those number which are divisble by 3 
#include<iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    for(int i=1;i<=n;i++){
        if(i%3==0){
            continue;
        }
        cout<<i<<"";
        
    }
    cout<<"\n";
    return 0;
}

