//1.5--->hybrid inheritance
#include<iostream>
using namespace std;
class A{
    public:
      void print(){
          cout<<"BJP wons";
      }
};
class B: public A{
    //no logic
};
class C: public A{
    //no  logic
};
class D:public B,public C{
    //no logic
};
int main(){
    D obj1;
    obj1.B::print();
}

