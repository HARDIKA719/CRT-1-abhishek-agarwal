//nearest greatest to left
#include<bits/stdc++.h>
using namespace std;

int main(){
    int a[]={2,3,1,4,7,3,1};
    int n=7;
    stack<int> st;
    vector<int> ngr;
    for(int i=0;i<n;i++){
        while(!st.empty() and a[i]>=st.top()){
            st.pop();
        }
        if(st.empty()){
            ngr.push_back(-1);
            st.push(a[i]);
        }
        else if(a[i]<st.top()){
            ngr.push_back(st.top());
            st.push(a[i]);
        }
    }
    reverse(ngr.begin(),ngr.end());
    for(auto i:ngr) cout<<i<<" ";
}
